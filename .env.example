# ─── Backend (apps/backend/.env) ──────────────────────────────────────────────

# PostgreSQL. Port 5436 matches the mapping in docker-compose.yml.
DATABASE_URL="postgresql://postgres:password@localhost:5436/qmanager?schema=public"

# Signing key for access/refresh tokens. MUST be set to a long random value in
# production — the code falls back to a well-known default otherwise.
JWT_SECRET="change-me-to-a-long-random-string"

# Signs the short-lived token the PDF renderer uses to read /internal/*.
# Falls back to JWT_SECRET when unset.
INTERNAL_RENDER_SECRET=""

# Where the API can reach the Next.js app. Used to drive the headless renderer
# and to build customer portal links.
FRONTEND_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Browser origins allowed to call the API (comma separated). If unset, the
# values of NEXT_PUBLIC_APP_URL / FRONTEND_URL are used, then localhost:3000.
# Note: a wildcard is NOT valid here because the API sends credentials.
CORS_ORIGINS="http://localhost:3000"

# Requests per IP per 15 minutes.
RATE_LIMIT_MAX="1000"

# Redis, for the optional BullMQ document pipeline.
# Port 6402 matches the mapping in docker-compose.yml.
REDIS_HOST="localhost"
REDIS_PORT="6402"

# The async PDF pipeline (queue -> worker -> MinIO -> Document records) is off
# by default so the API does not require Redis to boot. Set to 1 to enable
# POST /pdf/sample-quotation and the QR verification chain.
ENABLE_PDF_QUEUE="0"

# MinIO object storage. Port 9002 matches the mapping in docker-compose.yml.
MINIO_ENDPOINT="localhost"
MINIO_PORT="9002"
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="qmanager-documents"

# API listen port.
PORT="3001"

# Break-glass only: makes seed-permissions-live.ts grant Super Admin to EVERY
# existing user. Leave unset.
# GRANT_SUPER_ADMIN_TO_ALL="1"


# ─── Frontend (apps/frontend/.env) ────────────────────────────────────────────

NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
