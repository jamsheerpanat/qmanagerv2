<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  RELEASE configuration.

	  App Transport Security is left fully enabled: no exception domains, no
	  arbitrary loads. Shipping builds talk to the production API over HTTPS
	  only, and ServerSettingsView refuses non-HTTPS addresses in Release.

	  The localhost cleartext exception lives in Config/Info-Debug.plist so it
	  cannot reach the App Store.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
	</dict>
</dict>
</plist>
